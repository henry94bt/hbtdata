# hbtdata.es · Apache / LiteSpeed (Hostinger)
# Súbelo a la raíz del dominio, junto a index.html. Es un archivo oculto:
# activa "Mostrar archivos ocultos" en el Administrador de archivos.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

# ---------- Dominio canónico (sin www). A HTTPS ya redirige Hostinger ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.hbtdata.es -> hbtdata.es
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---------- 404 propio ----------
ErrorDocument 404 /404.html

# ---------- Compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Caché del navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
</IfModule>

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=2592000"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
